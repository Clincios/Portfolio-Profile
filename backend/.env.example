# Local default: SQLite. On Render, paste the Postgres URL as-is
# (postgres:// or postgresql://); the app rewrites it to postgresql+psycopg2://.
DATABASE_URL=sqlite:///./portfolio.db
SECRET_KEY=change-me-in-production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# SMTP (optional — contact form still saves to DB without it)
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@example.com
MAIL_PORT=587
MAIL_SERVER=smtp.gmail.com
MAIL_TO=your@email.com
MAIL_STARTTLS=true
MAIL_SSL_TLS=false

CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
